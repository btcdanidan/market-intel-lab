APP_NAME=market-intel-lab
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

DATABASE_URL=postgresql+psycopg://market:market@postgres:5432/market_intel
REDIS_URL=redis://redis:6379/0

SCHEDULE_CRON=0 8 * * *
SCHEDULE_TIMEZONE=UTC
REPORTS_DIR=reports

ASSET_UNIVERSE=BTC,ETH,SOL,BNB,XRP
EXCHANGES=binance,coinbase
PRIMARY_OPTIONS_VENUE=deribit

PORTFOLIO_EQUITY=100000
PER_TRADE_RISK_PCT=1.0
MAX_GROSS_EXPOSURE=2.5
DRAWDOWN_KILL_SWITCH_PCT=10.0
STOP_ATR_MULTIPLIER=1.2

BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_TEMPERATURE=0.2
OPENAI_CHAT_MAX_OUTPUT_TOKENS=700
CHAT_MAX_TURNS=12
